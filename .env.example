# Production template: replace placeholders before startup. See .env.render.example
# for the existing Render URL. Never commit real credentials.
DOMAIN=cvfrance.example.com
PORT=3000
DATA_DIR=./data
BACKUP_DIR=./backups
NODE_ENV=production
APP_STAGE=production
DATABASE_URL=
DATABASE_CA_CERT_PATH=
DB_POOL_MAX=5
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
ALLOWED_ORIGIN=https://cvfrance.example.com
PUBLIC_BASE_URL=https://cvfrance.example.com
SUPPORT_EMAIL=support@cvfrance.example.com
ADMIN_EMAIL=admin@cvfrance.example.com

# Unused during free launch; billing remains disabled by the generated server
PREMIUM_DISPLAY_PRICE=4,99 €/mois

# Email
# brevo or smtp in production; console is for isolated development only
EMAIL_MODE=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Jovelya
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Free launch: leave Stripe credentials empty
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
# Optional: use a specific Stripe Billing Portal configuration
STRIPE_PORTAL_CONFIGURATION_ID=

# Free launch: no external AI; mock does not pass production readiness
AI_MODE=disabled

# OpenAI mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Generic HTTP JSON mode
AI_API_KEY=
AI_API_BASE_URL=

# Safety/abuse limit for Premium AI requests
AI_DAILY_LIMIT=100

# Privacy-first: analytics disabled by default
ANALYTICS_MODE=off

# Pilot controls
MAINTENANCE_MODE=off

# Beta access
# open = everyone can register
# invite = invite code required
# closed = registration disabled
REGISTRATION_MODE=invite

# Fallback invite codes only. Prefer managing invites from Admin in v18.
BETA_INVITE_CODES=

# Keep feedback during pilot
FEEDBACK_ENABLED=true

# Client diagnostics for beta
CLIENT_ERROR_REPORTING=on
