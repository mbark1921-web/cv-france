# Jovelya 20.7.0 — production-security configuration for the existing Render service

NODE_ENV=production
APP_STAGE=production
PORT=3000

# Ephemeral unless a persistent disk is separately configured; not a durable backup
DATA_DIR=/data
BACKUP_DIR=/data/backups

# Existing service URL; replace all three together when the final domain is verified
DOMAIN=cv-france-staging.onrender.com
PUBLIC_BASE_URL=https://cv-france-staging.onrender.com
ALLOWED_ORIGIN=https://cv-france-staging.onrender.com

# Supply securely from the provider. Never commit a real connection string.
# Percent-encode credentials; use the exact provider pooler username/host/port.
DATABASE_URL=
DB_POOL_MAX=5
# Optional absolute path to the provider CA certificate, never a private key
DATABASE_CA_CERT_PATH=

JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=YOUR_REAL_ADMIN_EMAIL
SUPPORT_EMAIL=YOUR_REAL_SUPPORT_EMAIL

REGISTRATION_MODE=open
BETA_INVITE_CODES=
FEEDBACK_ENABLED=true
CLIENT_ERROR_REPORTING=on
MAINTENANCE_MODE=off

# Production readiness requires real email configuration; delivery still needs a test
EMAIL_MODE=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Jovelya
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Free launch: leave billing credentials empty
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=

# Free launch: no external AI calls
AI_MODE=disabled
AI_DAILY_LIMIT=100
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

ANALYTICS_MODE=off
