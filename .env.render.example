# Render Staging — values to create in Render Environment

NODE_ENV=production
APP_STAGE=staging
PORT=3000

# Persistent disk mount
DATA_DIR=/data
BACKUP_DIR=/data/backups

# Replace with the HTTPS Render URL after first deploy
DOMAIN=YOUR-SERVICE.onrender.com
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
ALLOWED_ORIGIN=https://YOUR-SERVICE.onrender.com

JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=YOUR_REAL_ADMIN_EMAIL
SUPPORT_EMAIL=YOUR_REAL_SUPPORT_EMAIL

REGISTRATION_MODE=invite
BETA_INVITE_CODES=
FEEDBACK_ENABLED=true
CLIENT_ERROR_REPORTING=on
MAINTENANCE_MODE=off

# Staging e-mail can stay console first
EMAIL_MODE=console
EMAIL_FROM=CV France <no-reply@YOUR-DOMAIN>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Staging Stripe: use TEST keys only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=

# Start with mock AI
AI_MODE=mock
AI_DAILY_LIMIT=100
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

ANALYTICS_MODE=off
